apiVersion: getambassador.io/v3alpha1
kind: Mapping
metadata:
  name: $SERVICE_NAME-$COUNTRY-mapping
  namespace: $NAMESPACE
spec:
  host: "$AMBASSADOR_HOST"
  prefix: $PREFIX       # public URL path — what the browser sends
  rewrite: $REWRITE     # what your app receives — almost always /
  service: $SERVICE_NAME-service.$NAMESPACE.svc.cluster.local:$PORT

