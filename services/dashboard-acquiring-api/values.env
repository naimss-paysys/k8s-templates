SERVICE_NAME=dashboard-acquiring-api
IMAGE=dashboard-acquiring-api
TAG=1.0.21-TZ
CONFIG_VERSION=v3
CONFIGMAP_NAME=dashboard-acquiring-api-config
PORT=5503
ENVIRONMENT=test
CI=false
NAMESPACE=test-mmp
PREFIX=/dashboard-acquiring-api/
REWRITE=/

# ================================================================
# FILE: services/dashboard-backoffice/values.env
# ================================================================


# ── Resources ─────────────────────────────────────────────────────
# Based on: kubectl top showing 12m CPU / 1027Mi RAM
# requests = actual × 1.5  →  limits = actual × 2.5
# Category: heavy (Spring Boot, high memory)
CPU_REQUEST=200m
MEMORY_REQUEST=1024Mi
CPU_LIMIT=800m
MEMORY_LIMIT=1536Mi

# ── HPA ───────────────────────────────────────────────────────────
# Remove these 4 lines to disable autoscaling
HPA_MIN=1
HPA_MAX=2
HPA_CPU_THRESHOLD=90
HPA_MEM_THRESHOLD=75
CONFIGMAP_FULL_NAME=dashboard-acquiring-api-config-v3-1.0.21-tz
