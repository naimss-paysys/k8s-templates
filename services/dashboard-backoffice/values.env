SERVICE_NAME=dashboard-backoffice
CONFIGMAP_NAME=dashboard-backoffice-config
CONFIG_VERSION=v2
CI=true
IMAGE=dashboard-backoffice
TAG=1.0.18-TZ
PORT=5501
ENVIRONMENT=test
NAMESPACE=test-mmp
PREFIX=/dashboard-backoffice/
REWRITE=/

# ================================================================
# FILE: services/dashboard-backoffice/values.env
# =======upload=========================================================
upload_dir=/data/documents

# ── Resources ─────────────────────────────────────────────────────
# Based on: kubectl top showing 12m CPU / 1027Mi RAM
# requests = actual × 1.5  →  limits = actual × 2.5
# Category: heavy (Spring Boot, high memory)
CPU_REQUEST=200m
MEMORY_REQUEST=1536Mi
CPU_LIMIT=800m
MEMORY_LIMIT=2560Mi

# ── HPA ───────────────────────────────────────────────────────────
# Remove these 4 lines to disable autoscaling
#HPA_MIN=1
#HPA_MAX=4
#HPA_CPU_THRESHOLD=70
#HPA_MEM_THRESHOLD=75
#CI=false
