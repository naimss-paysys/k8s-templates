NAME=dashboard-merchant-api
IMAGE=registry.paysyslabs.com/dashboard-merchant-api
TAG=v1.0.4
PORT=5502
ENVIRONMENT=test
NAMESPACE=test-mmp
PREFIX=/dashboard-merchant-api/
REWRITE=/

# ── Resources ─────────────────────────────────────────────────────
# Based on: kubectl top showing 12m CPU / 1027Mi RAM
# requests = actual × 1.5  →  limits = actual × 2.5
# Category: heavy (Spring Boot, high memory)
CPU_REQUEST=200m
MEMORY_REQUEST=1536Mi
CPU_LIMIT=800m
MEMORY_LIMIT=2560Mi

# ── HPA ───────────────────────────────────────────────────────────
# Remove these 4 lines to disable autoscaling
HPA_MIN=1
HPA_MAX=4
HPA_CPU_THRESHOLD=60
HPA_MEM_THRESHOLD=75


#── CONFIG_MAP ───────────────────────────────────────────────────────────
MPAY_URL=http://10.245.0.169/web-service/acq/queueforwarding/




