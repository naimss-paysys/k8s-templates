SERVICE_NAME=dashboard-merchant-api
IMAGE=dashboard-merchant-api
TAG=1.0.22-TZ
PORT=5502
ENVIRONMENT=test
NAMESPACE=test-mmp
PREFIX=/dashboard-merchant-api/
REWRITE=/
CONFIGMAP_NAME=dashboard-merchant-api-config
CONFIG_VERSION=v3
# ── Resources ─────────────────────────────────────────────────────
# Based on: kubectl top showing 12m CPU / 1027Mi RAM
# requests = actual × 1.5  →  limits = actual × 2.5
# Category: heavy (Spring Boot, high memory)
CPU_REQUEST=200m
MEMORY_REQUEST=1536Mi
CPU_LIMIT=500m
MEMORY_LIMIT=2560Mi

# ── HPA ───────────────────────────────────────────────────────────
# Remove these 4 lines to disable autoscaling
HPA_MIN=1
HPA_MAX=2
HPA_CPU_THRESHOLD=60
HPA_MEM_THRESHOLD=75


#── CONFIG_MAP ───────────────────────────────────────────────────────────
MPAY_URL=https://mixxmmp-test.tigo.co.tz/web-service/acq/queueforwarding/




CI=true
CONFIGMAP_FULL_NAME=dashboard-merchant-api-config-v3-1.0.22-tz
