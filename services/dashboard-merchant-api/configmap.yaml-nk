apiVersion: v1
kind: ConfigMap
metadata:
  name: dashboard-merchant-api-config
  namespace: test-mmp
data:
  application.yaml: |
    server:
      port: 5502
      max-http-request-header-size: 64KB
      servlet:
        session:
          timeout: 5000
          cookie:
            secure: true
    
    springfox.documentation.swagger.v2.path: /docs
    swagger:
      enabled: true
    ajaxRequestTime: 10000
    maxSize: 5242880
    # allowedHeaders and allowedOrigins must not be '*', when allowCredentials is true
    allowedHeaders: 'Authorization,Content-Type,X-Requested-With,Accept,Origin,Access-Control-Allow-Origin,Access-Control-Allow-Credentials'
    allowedOrigins: '*'  # Change this to your frontend's URL(s), comma-separated if multiple
    #logging:
    #  config: file:logback.xml
    application:
      carriers:
        allowed: 030,031,032,033,034,035,036
        regex: '[0]{1}[3]{1}[0-6]{1}[0-9]{1}[\w-]{1}[0-9]{7}'
      cnic:
        regex: '[0-9]{5}[\w-]{1}[0-9]{7}[\w-]{1}[0-9]{1}'
      account-nick:
        regex: ((?![0-9]*$)[a-zA-Z0-9_-]+)
    password:
      wrong-attempt: 10
      regex: ((?=.*[a-z])(?=.*\d)(?=.*[A-Z])(?=.*[@#$%!]).{8,16})
      reset:
        token-expiration-minutes: 1440
    jwt:
      expiration-ms: 86400000  # 24 hours (24 * 60 * 60 * 1000)
      # Other common values:
      # 3600000   = 1 hour
      # 7200000   = 2 hours
      # 43200000  = 12 hours
      # 604800000 = 7 days
    spring:
      # Redis Configuration for JWT Token Caching
      redis:
        host: ${REDIS_HOST:10.0.150.126}
        port: 6379
        password:  # Leave empty if no password
        database: 0
        timeout: 2000ms
        lettuce:
          pool:
            max-active: 8
            max-idle: 8
            min-idle: 0
            max-wait: -1ms
      cache:
        type: redis
        redis:
          time-to-live: 86400000  # Match JWT expiration
          cache-null-values: false
      application:
        name: mms-dashboard
      servlet:
        multipart:
    
          max-file-size: 10MB
          max-request-size: 10MB
      thymeleaf:
        cache: false
      jmx:
        enabled: false
      #datasource:
        #type: com.zaxxer.hikari.HikariDataSource
        #driver-class-name: com.microsoft.sqlserver.jdbc.SQLServerDriver
        #url: jdbc:sqlserver://10.0.150.18:1440;instanceName=SQLSERVER;databaseName=acquiring-backoffice-development;encrypt=true;trustServerCertificate=true;
        #username: appuser
        #password: Silv3r@321
      datasource:
        type: com.zaxxer.hikari.HikariDataSource
        driver-class-name: org.postgresql.Driver
        url: ${DB_URL:jdbc:postgresql://10.0.150.11:5432/postgres}
        username: ${DB_USERNAME:postgres}
        password: ${DB_PASSWORD:postgres}
      jackson:
        serialization:
          FAIL_ON_EMPTY_BEANS: false
    
      hikari:
        pool-name: HikariPool
        maximum-pool-size: 10
        minimum-idle: 2
        idle-timeout: 900000         # 15 minutes
        connection-timeout: 30000    # 30 seconds
        max-lifetime: 1800000        # 30 minutes
        leak-detection-threshold: 120000  # 2 minutes
        validation-timeout: 5000
        auto-commit: true
    
          #url: jdbc:sqlserver://localhost:1433;instanceName=MSSQLSERVER;databaseName=MMSBackoffice_20210520
        #username: sk
        #password: waheed@1234
    
    
    
      jpa:
        generate-ddl: false
        hibernate:
          ddl-auto: none
        show-sql: false
        properties:
          hibernate:
            dialect: org.hibernate.dialect.PostgreSQLDialect
            id:
              new_generator_mappings: true
    
    #  jpa:
    #    database-platform: org.hibernate.dialect.PostgreSQLDialect
    #    generate-ddl: true
    #    hibernate:
    #      ddl-auto: update
    #    show-sql: false
    #    properties:
    #      hibernate:
    #        format_sql: true
    #        jdbc:
    #          lob:
    #            non_contextual_creation: true
    
    # Flowable BPM Configuration
    flowable:
      enabled: true
    dashboard:
      type: BACKOFFICE
      api:
        key: 89e760d3-2f8a-4a1b-95b0-ce579d7941bb
        secret: 24e30cde-6cc6-4216-a710-486f04e38e54
    page:
      size: 10
    email:
      from_name: paysyslabs
      from_email: watcher@paysyslabs.com
      url: http://10.0.150.21:7034/api/EmailService
      change:
        password_backoffice: http://10.0.150.16:3001
        password_portal: http://localhost:6097
    user:
      backoffice:
        key: 98a4aaaa-8de8-47fd-97cb-2d28415c2bf6
        secret: d41020e0-77d7-4f65-8132-3a17fc70bc35
    
    token:
      store:
        eviction: 280000
        type: redis  # Changed from memcached to redis
        # Redis connection is configured in spring.redis section above
    
    jasper:
      key: amFzcGVyYWRtaW46amFzcGVyYWRtaW4=
      endpoint:
        role: http://10.0.70.52:8086/jasperserver/rest_v2/roles/
        user: http://10.0.70.52:8086/jasperserver/rest_v2/users/
    jasper_url: http://10.0.70.52:8086/jasperserver/flow.html?_flowId=searchFlow&j_username=
    refresh_time: 2000
    
    #multipart:
    #    maxFileSize: 5Mb
    #    maxRequestSize: 5Mb
    blacklistJwt.cache:
      name: blacklistJwtCache
      timeout: 36000000 # 10 hours = 10 * 60 * 60 * 1000
    secret_key : "d4f12d6c8e9a9d0b"  #Should always be 16 alphanumeric characters
    
    # JWT Configuration moved to the top of the file (line 36)
    # Using the value from line 36: expiration-ms: 86400000 (24 hours)
    #  | Duration   | Milliseconds (`expiration-ms`) |
    #  | ---------- | ------------------------------ |
    #  | 10 seconds | 10000                          |
    #  | 1 minute   | 60000                          |
    #  | 10 minutes | 600000                         |
    #  | 1 hour     | 3600000                        |
    #  | 10 hours   | 36000000                       |
    #  | 24 hours   | 86400000                       |
    
    security:
      login:
        max-failures: 5
        lock-duration-minutes: 1 # in minutes
    aggregator : Faisal Bank Limited
    
    rate-limit:
      max-requests: 5 # MAX VALUE PERE REQUEST
      base-window-ms: 60000   # PER MINUTE
      penalty-ms: 10000        # 10 seconds PENDALITY FOR
    
    management:
      health:
        ldap:
          enabled: false
      endpoints:
        web:
          exposure:
            include: "*"
      endpoint:
        health:
          show-details: always
        service-status:
          enabled: true
    
    backoffice:
      connect:
        timeout: 5000  # Connection timeout in milliseconds (5 seconds)
      read:
        timeout: 5000  # Read timeout in milliseconds (5 seconds)
      stan: 1  # STAN (System Trace Audit Number) initial value
    
    two-fa:
      public-key-path: D:\keys\key-public.pem
      time-left: 60 # in seconds e.g. 60 secs
    
    # Bank Transfer Configuration (Telepin/MMP Integration)
    bank:
      transfer:
        telepin:
          endpoint: http://10.0.150.126:3011/TigoPaymentGateway_1_2
          consumerId: mfs_app_new
          terminalType: USD
          shortCode: 50111
          feeCheckOperation: 2022
    
    
    external-onboarding:
      identification: MSISDN
      maker: Labesh_Maker
    
    service:
      url:
        queue: http://10.0.150.126:7033/acq/queueforwarding/
      secret: paysys@123
      timeout: 30000  # 30 seconds timeout for MPAY calls
      retry:
        attempts: 3
        delay-ms: 1000
    
    wallet:
      api:
        balance:
          endpoint: http://10.0.150.126:3011/osb/services/GetBalance_3_0
        account-status:
          endpoint: http://10.0.150.126:3011/osb/services/ViewMFSAccountType_1_0
        username: live_mfs_app
        password: <your_password>
        consumer-id: mfs_app_new
        country: TZA
        short-code: 600747
        channel-user: self.care.app
        channel-password: <your_channel_password>
    
    # Handler Management Configuration
    handler:
      management:
        handler-id-prefix: S
        features-role-name: Merchant_Portal  # Role whose authorities define available handler features
        telepin:
          create-account-service: axian-create-mfs-account
          change-pin-service: axian-change-pin
          disable-handler-service: axian-mmp-disable-terminal-user
          transaction-query-service: axian-transaction-query-status
          terminalType: API
          channelUser: mixx.merchant
          channelUserPin: GoMixx@2026
          serviceAccount: 25571123131
          pin: 2026
    
    # Scheduled Payment (Settlement) Configuration
    scheduled:
      payment:
        # Telepin Service Names
        service:
          transfer: axian-mmp-proxy-transfer     # Transfer initiation service
          inquiry: axian-transaction-query-status # Transaction status inquiry service
        # Telepin Authentication
        consumer-id: mfs_app_new
        channel-user: <channel_username>         # Update with actual channel username
        channel-pass: <channel_password>         # Update with actual channel password
        terminal-type: API
        payment-type: PAYMENT_PROXY
        # W2W Transfer Configuration
        w2w-shortcode: <w2w_shortcode>            # Update with actual W2W shortcode
        # Processing Configuration
        batch-limit: 100                          # Max schedules to process per job run
        max-inquiry-retries: 3                    # Max inquiry retries before marking WAIT_FOR_ASYNC
        timezone: Africa/Dar_es_Salaam            # Default timezone for schedule calculations
    
    transaction:
      inquiry:
        telepin:
          endpoint: https://accessgwtest.tigo.co.tz:8443/SuperAppTransInquiry2TigoTQS
          type: MTPGGetSODetails
        inquiryDelayMs: 500
        inquiryMaxAttempts: 5
    
    MERCHANT_PREFIXES:
      EAN: "02501"
    
